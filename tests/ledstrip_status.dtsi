/*
 * Shared setup for the native_sim tests: a fake 3-LED strip that logs frames,
 * a fake fuel gauge, emulated GPIOs for the supply switch, charger and VBUS,
 * and a 4x4 mock matrix whose keys drive them.
 */

#include <behaviors.dtsi>
#include <behaviors/ledstrip_status.dtsi>
#include <dt-bindings/zmk/kscan_mock.h>
#include <dt-bindings/zmk/ledstrip_status_test.h>

/ {
    chosen {
        zmk,battery = &test_battery;
    };

    test_battery: test_battery {
        compatible = "zmk,ledstrip-status-test-battery";
    };

    test_strip: test_strip {
        compatible = "zmk,ledstrip-status-test-strip";
        chain-length = <3>;
        supply-gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
    };

    /* the same pin wiring as the Forager */
    status_leds: status_leds {
        compatible = "zmk,ledstrip-status";
        led-strip = <&test_strip>;
        enable-gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
        charge-gpios = <&gpio0 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        vbus-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
    };

    behaviors {
        lst: lst {
            compatible = "zmk,behavior-ledstrip-status-test";
            #binding-cells = <2>;
            vbus-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
            charge-gpios = <&gpio0 1 GPIO_ACTIVE_LOW>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &lst LST_BATTERY 70  &lst LST_BATTERY 45   &lst LST_BATTERY 25  &lst LST_BATTERY 12
                &lst LST_BATTERY 5   &lst LST_BATTERY 100  &lst LST_VBUS 1      &lst LST_VBUS 0
                &lst LST_CHARGE 1    &lst LST_CHARGE 0     &lst LST_SLEEP 0     &lst LST_WAKE 0
                &led_status_bat      &led_status_con       &none                &none
            >;
        };
    };
};

&kscan {
    rows = <4>;
    columns = <4>;
};

/* key positions, for the test scripts */
#define BAT_70 0, 0
#define BAT_45 0, 1
#define BAT_25 0, 2
#define BAT_12 0, 3
#define BAT_5 1, 0
#define BAT_100 1, 1
#define VBUS_ON 1, 2
#define VBUS_OFF 1, 3
#define CHG_ON 2, 0
#define CHG_OFF 2, 1
#define SLEEP 2, 2
#define WAKE 2, 3
#define SHOW_BAT 3, 0
#define SHOW_CON 3, 1
#define NOP 3, 3

/* tap a key after waiting `ms` */
#define TAP(key, ms) ZMK_MOCK_PRESS(key, ms) ZMK_MOCK_RELEASE(key, 10)
